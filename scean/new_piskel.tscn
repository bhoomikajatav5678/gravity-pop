[sub_resource type="GDScript" id="GDScript_0r2v6"]
script/source = "
extends CharacterBody2D

signal coins_changed(total_coins: int)
@export var normal_speed: float = 300.0
@export var sprint_speed: float = 550.0
@export var jump_force: float = -450.0
@export var gravity: float = 980.0
@export var fall_limit: float = 700.0

# Realistic bounce settings
@export var bounce_force: float = -300.0
@export var max_bounces: int = 2

var coins: int = 0
var sprinting: bool = false
var starting_position: Vector2
var bounce_count: int = 0
var was_on_floor: bool = false

func _ready():
	starting_position = global_position
	add_to_group(\"players\")
 

func _physics_process(delta):

	# Gravity
	if not is_on_floor():
		velocity.y += gravity * delta

	# Movement
	var direction = Input.get_axis(\"ui_left\", \"ui_right\")

	if Input.is_key_pressed(KEY_A):
		direction = -1
	elif Input.is_key_pressed(KEY_D):
		direction = 1

	var current_speed = sprint_speed if sprinting else normal_speed
	velocity.x = direction * current_speed

	# Jump
	if Input.is_key_pressed(KEY_W) and is_on_floor():
		velocity.y = jump_force
		bounce_count = 0

	# Detect landing
	move_and_slide()

	if is_on_floor() and not was_on_floor:
		if bounce_count < max_bounces:
			velocity.y = bounce_force
			bounce_count += 1

	was_on_floor = is_on_floor()

	# Respawn after falling
	if global_position.y > fall_limit:
		respawn()


func _input(event):
	# Toggle sprint
	if event is InputEventKey:
		if event.pressed and not event.echo:
			if event.keycode == KEY_SHIFT:
				sprinting = !sprinting


func take_hit():
	respawn()


func respawn():
	global_position = starting_position
	velocity = Vector2.ZERO
	sprinting = false
	bounce_count = 0
	was_on_floor = false
	
func collect_coin(amount: int):
	coins += amount
	coins_changed.emit(coins)
	print(\"Coins collected: \", coins)
"

